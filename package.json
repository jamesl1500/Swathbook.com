{
  "name": "swathbook",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter swathbook-web test:e2e",
    "app": "pnpm --filter swathbook-client-app start",
    "db:start": "supabase start -x vector,logflare,edge-runtime,imgproxy",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:push": "supabase db push --linked",
    "db:types": "supabase gen types typescript --local --schema public > apps/swathbook-web/src/libs/supabase/database.types.ts && node -e \"require('fs').copyFileSync('apps/swathbook-web/src/libs/supabase/database.types.ts', 'apps/swathbook-client-app/src/data/database.types.ts')\""
  },
  "devDependencies": {
    "supabase": "^2.122.1",
    "turbo": "^2.11.10"
  }
}
