# Copy to .env.local (git-ignored) and fill in. EXPO_PUBLIC_ values are built
# into the app, so only ever put public values here.

# Supabase project URL and publishable key (same values as the web app's
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The web app (apps/swathbook-web). The app calls its /api/app routes and opens
# its booking pages for payments. Locally: http://localhost:3000. On a phone,
# use your computer's LAN address instead of localhost (for Supabase too).
EXPO_PUBLIC_SITE_URL=
