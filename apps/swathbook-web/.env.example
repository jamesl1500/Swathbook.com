# Copy to .env and fill in. Both Supabase values are on your project's
# Settings > API Keys page. They're safe to expose to the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Base URL used in auth email links (confirm signup, reset password).
# Must also be listed under Supabase Auth > URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:3000

# Server-only. Settings > API Keys > Secret keys. Used for Stripe webhooks, the
# public booking flow and saving planned routes. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Stripe Connect (Express accounts, direct charges). Leave blank to run without
# payments: booking still works and Payouts shows "not configured".
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret(s) of the event destinations pointed at /api/stripe/webhook.
# In production there are two (platform + connected accounts): comma-separate them.
STRIPE_WEBHOOK_SECRET=whsec_platform...,whsec_connected...
# Platform fee on each charge in basis points (100 = 1%). 0 = no fee.
STRIPE_PLATFORM_FEE_BPS=0

# Server-only Google Maps Platform key with Places API (New), Geocoding API,
# Routes API and Maps Static API enabled. Blank = address autocomplete off and
# routes use straight-line drive estimates.
GOOGLE_MAPS_API_KEY=

# Email (booking confirmations, deposit reminders, team invites) through Resend.
# Verify your sending domain in Resend first. Leave RESEND_API_KEY blank in
# development to deliver to the local Supabase Mailpit inbox instead (set
# MAILPIT_URL to the "Mailpit URL" from `pnpm exec supabase status`).
RESEND_API_KEY=
EMAIL_FROM="Swathbook <bookings@swathbook.com>"
MAILPIT_URL=http://127.0.0.1:55424

# Shared secret for /api/cron/notifications (releases unpaid deposit holds and
# sends due emails). pg_cron calls it every minute once you add two Supabase
# Vault secrets: app_url (this site's URL) and cron_secret (this value).
CRON_SECRET=
